rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Helper Functions
    // ==========================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if user is therapist
    function isTherapist() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'therapist';
    }
    
    // Check if user is parent
    function isParent() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }
    
    // ==========================================
    // Users Collection
    // ==========================================
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for therapist listings, etc.)
      allow read: if isSignedIn();
      
      // Users can create their own profile during signup
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Users can update their own profile, or admin can update any profile
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admin can delete users
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // Appointments Collection
    // ==========================================
    match /appointments/{appointmentId} {
      // Users can read appointments where they are parent, therapist, or admin
      allow read: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.therapistId == request.auth.uid ||
        isAdmin()
      );
      
      // Parents can create appointments
      allow create: if isSignedIn() && isParent();
      
      // Parents can update their own appointments (before confirmed)
      // Therapists can update appointments assigned to them (to confirm/complete)
      // Admins can update any appointment
      allow update: if isSignedIn() && (
        (resource.data.parentId == request.auth.uid && resource.data.status == 'pending') ||
        resource.data.therapistId == request.auth.uid ||
        isAdmin()
      );
      
      // Only admins and the parent who created it can delete appointments
      allow delete: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // ==========================================
    // Symptoms Collection (child symptoms tracking)
    // ==========================================
    match /symptoms/{symptomId} {
      // Parents can read their own symptoms entries
      // Therapists can read symptoms for their patients
      // Admins can read all
      allow read: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        isTherapist() ||
        isAdmin()
      );
      
      // Parents can create symptoms entries
      allow create: if isSignedIn() && isParent();
      
      // Parents can update their own symptoms entries
      allow update: if isSignedIn() && resource.data.parentId == request.auth.uid;
      
      // Parents and admins can delete symptoms entries
      allow delete: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // ==========================================
    // Reviews Collection (for therapist reviews)
    // ==========================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if isSignedIn();
      
      // Parents can create reviews after completing appointments
      allow create: if isSignedIn() && isParent();
      
      // Parents can update their own reviews
      allow update: if isSignedIn() && resource.data.parentId == request.auth.uid;
      
      // Parents and admins can delete reviews
      allow delete: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
    }
    
    // ==========================================
    // Notifications Collection
    // ==========================================
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // System or admins can create notifications
      allow create: if isSignedIn();
      
      // Users can update their own notifications (mark as read)
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // Default Rule: Deny all other access
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
